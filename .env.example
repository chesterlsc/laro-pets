# Public site URL (no trailing slash). Used for canonical, OG, sitemap and PayMongo redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayMongo (https://dashboard.paymongo.com/developers) — use sk_test_… while testing
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Supabase (Project settings → API). Leave blank to fall back to ORDERS_WEBHOOK_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fallback order storage: a Google Apps Script / Make / Zapier webhook that appends a row to a Sheet
ORDERS_WEBHOOK_URL=

# Resend (https://resend.com) — emails to the owner and the customer
RESEND_API_KEY=
STORE_OWNER_EMAIL=

# Analytics — each script loads only when its ID is set
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
